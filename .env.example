# Root compose settings. Copy to .env on every host before running:
#   docker compose up -d                                                 (local)
#   docker compose -f docker-compose.yml --profile production up -d     (production)
#
# Admin password of the central Grafana. Required: the stack does not start
# without it. Use a strong, unique value in production.
GRAFANA_ADMIN_PASSWORD=change-me

# Public domain of the central Grafana, routed by the shared Traefik in
# production (needs a DNS record). Leave empty locally; Grafana is then at
# http://localhost:3001.
MONITORING_DOMAIN=
# Set to true when MONITORING_DOMAIN is set, so Grafana cookies are HTTPS-only.
GRAFANA_COOKIE_SECURE=false

# Contact e-mail for the Let's Encrypt ACME account. Optional, but recommended
# so certificate problems can be reported to an operator.
TRAEFIK_ACME_EMAIL=admin@example.com
