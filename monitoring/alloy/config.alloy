// Central homeBuddy log collector (see openspec homebuddy-logging).
// Tails stdout and stderr of every homeBuddy container through the read-only Docker
// socket and pushes the lines to the central Loki. Containers of other projects on the
// same host are dropped before they are tailed.

// List the containers on the host. Containers started later are picked up on refresh.
discovery.docker "containers" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "5s"
}

// Keep only homeBuddy containers and set the target labels.
discovery.relabel "homebuddy" {
	targets = discovery.docker.containers.targets

	// Docker reports container names with a leading slash.
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(homebuddy|authbuddy|finanzbuddy|calendarbuddy)-.*"
		action        = "keep"
	}

	// `service` comes from the container name prefix, so it matches the metric `service`
	// label even if a stack runs under another Compose project name.
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(homebuddy|authbuddy|finanzbuddy|calendarbuddy)-.*"
		target_label  = "service"
		replacement   = "$1"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "component"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
		replacement   = "$1"
	}
}

// Applied per log entry: the log stream is known only while tailing.
discovery.relabel "stream" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "stream"
	}
}

loki.source.docker "homebuddy" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.relabel.homebuddy.output
	relabel_rules = discovery.relabel.stream.rules
	forward_to    = [loki.write.central.receiver]
}

// Lines must survive a Loki outage of any length: once a line is read, its Docker read
// position has advanced and it is never read again. With unlimited retries a pending
// batch is kept in memory and resent until Loki accepts it. Restarting Alloy while Loki is
// down loses that batch; the experimental loki.write WAL (Alloy v1.22) does not replay it
// after a restart either, so it is not used.
loki.write "central" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"

		// 0 retries forever; the default of 10 drops a batch after about 8.5 minutes.
		max_backoff_retries = 0
		// Resume delivery within a minute after Loki returns.
		max_backoff_period = "1m"
	}
}

// Central homeBuddy trace receiver (see openspec homebuddy-tracing).
// Services send OTLP over HTTP to homebuddy-alloy:4318 over their <service>-metrics network.
// Alloy removes attributes that may carry credentials, batches the spans, and forwards them
// to the central Tempo on the root default network. Tempo itself joins no service network.

// HTTP only: no gRPC listener, so 4318 is the only port services can reach. Alloy's own
// HTTP server (UI, debug, /metrics) listens on 127.0.0.1:12345 only (see docker-compose.yml).
otelcol.receiver.otlp "services" {
	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		traces = [otelcol.processor.attributes.scrub.input]
	}
}

// Second line of defense: services must not record these attributes in the first place.
otelcol.processor.attributes "scrub" {
	action {
		key    = "http.request.header.authorization"
		action = "delete"
	}

	action {
		key    = "http.request.header.cookie"
		action = "delete"
	}

	action {
		key    = "http.response.header.set-cookie"
		action = "delete"
	}

	action {
		pattern = "(?i).*(password|token|secret).*"
		action  = "delete"
	}

	output {
		traces = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

// Traces are diagnostic: while Tempo is down the in-memory queue retries and drops spans
// once it is full. There is no persistent queue.
otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"

		// Plain gRPC: the traffic stays on the root default network.
		tls {
			insecure = true
		}
	}
}
