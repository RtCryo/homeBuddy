  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate per component",
      "description": "Server spans per second, computed from traces (TraceQL metrics on Tempo's local blocks).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{resource.service.namespace=~\"$service\" && resource.service.name=~\"$component\" && kind=server} | rate() by (resource.service.name)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate per component",
      "description": "Server spans with an error status per second.",
